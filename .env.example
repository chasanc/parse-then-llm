# Copy to .env (never commit .env). Compose reads it from this folder.
# In a real deployment don't ship a .env: inject these from your secret store.

# Shared by the API and both extractors. Required; compose refuses to start while empty.
HMAC_SECRET=

# Postgres. Dev default; the local test suite connects with this password too.
POSTGRES_PASSWORD=postgres

# Tier 2: "mock" replays the answer key offline, "claude" calls the API and needs the key.
LLM_PROVIDER=mock
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=

MAX_DOCUMENT_BYTES=20971520
COVERAGE_THRESHOLD=1.0

PTL_API_KEY=1234567890